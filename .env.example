# A long random string used to sign session cookies. Required outside
# debug mode — the app refuses to start without it (see app/__init__.py).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLAlchemy connection string. Leave blank for local dev — defaults to a
# SQLite file at ./app.db. For Postgres: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# Enables Flask/Werkzeug debug mode (interactive debugger, auto-reload) and
# relaxes the SECRET_KEY requirement above. Set to 1 or true for local dev;
# leave blank/unset in any deployed environment.
FLASK_DEBUG=
